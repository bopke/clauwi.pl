{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "clauwi",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-26",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// STAGING domain while the real clauwi.pl cutover is pending — the apex
	// already has DNS pointing at the live legacy WordPress host, so Workers
	// Custom Domains can't attach there yet without first clearing those
	// records (a deliberate, separate decision — see clauwi-rewrite-project
	// memory). Swap back to clauwi.pl (custom_domain: true) when ready to cut
	// over; `wrangler deploy` will provision the DNS record + certificate.
	"routes": [
		{
			"pattern": "staging.clauwi.pl",
			"custom_domain": true
		}
	],
	/**
   * D1 database binding. Access in server code via getCloudflareContext().env.DB.
   * Run `npx wrangler d1 create clauwi-db` and paste the returned database_id
   * below before deploying. Local dev works without a real id.
   */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "clauwi-db",
			"database_id": "046af734-ae68-4958-9d75-7e479349b44d",
			"migrations_dir": "migrations"
		},
		{
			"binding": "clauwi_db",
			"database_name": "clauwi-db",
			"database_id": "046af734-ae68-4958-9d75-7e479349b44d",
			"remote": true
		}
	],
	/**
   * R2 bucket for migrated media (blog images, page assets from wp-content/uploads).
   * Access via getCloudflareContext().env.MEDIA.
   * Run `npx wrangler r2 bucket create clauwi-media` before deploying.
   * Local dev uses a simulated bucket under .wrangler/state — no remote bucket needed.
   */
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "clauwi-media"
		}
	]
}