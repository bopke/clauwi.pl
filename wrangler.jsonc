{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "clauwi",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-26",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	/**
   * Plain-text environment variables.
   *
   * These MUST live here rather than being typed into the Cloudflare
   * dashboard: for non-secret vars this file is authoritative, so every
   * deploy replaces the Worker's variables with exactly what it declares.
   * Values set only in the dashboard are dropped by the next deploy — that is
   * how BREVO_SENDER_EMAIL / BREVO_SENDER_NAME / CONTACT_FORM_TO /
   * COURSE_ORGANIZER_EMAIL disappeared on 2026-08-20 and broke e-mail on
   * staging. Recovered here from version eefdae6e.
   *
   * Anything genuinely secret (BREVO_API_KEY, AUTH_*, TURNSTILE_SECRET_KEY)
   * stays a `wrangler secret` — secrets are NOT touched by deploys.
   *
   * Values below were read back from the live Worker (version e7582c60,
   * 2026-08-20 20:02 UTC) so config and deployment now agree.
   */
	"vars": {
		"BREVO_SENDER_EMAIL": "kontakt@clauwi.pl",
		"BREVO_SENDER_NAME": "ClauWi®",
		// NOTE: both recipients currently point at the developer's own inbox
		// for end-to-end e-mail testing. Swap to the client's real addresses
		// before handover (they were kontakt@bopke.dev / kontakt2@bopke.dev
		// earlier, and the site's own contact address is iza@naturalnamama.pl).
		"CONTACT_FORM_TO": "bobekrobal@gmail.com",
		"COURSE_ORGANIZER_EMAIL": "bobekrobal@gmail.com",
		// Only needed while the app lives on staging. The code falls back to
		// the request's own host, so this can simply be deleted after the
		// clauwi.pl cutover.
		"EMAIL_BASE_URL": "https://staging.clauwi.pl"
	},
	"observability": {
		"enabled": true
	},
	// STAGING domain while the real clauwi.pl cutover is pending — the apex
	// already has DNS pointing at the live legacy WordPress host, so Workers
	// Custom Domains can't attach there yet without first clearing those
	// records (a deliberate, separate decision — see clauwi-rewrite-project
	// memory). Swap back to clauwi.pl (custom_domain: true) when ready to cut
	// over; `wrangler deploy` will provision the DNS record + certificate.
	"routes": [
		{
			"pattern": "staging.clauwi.pl",
			"custom_domain": true
		}
	],
	/**
   * D1 database binding. Access in server code via getCloudflareContext().env.DB.
   * Run `npx wrangler d1 create clauwi-db` and paste the returned database_id
   * below before deploying. Local dev works without a real id.
   */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "clauwi-db",
			"database_id": "046af734-ae68-4958-9d75-7e479349b44d",
			"migrations_dir": "migrations"
		},
		{
			"binding": "clauwi_db",
			"database_name": "clauwi-db",
			"database_id": "046af734-ae68-4958-9d75-7e479349b44d",
			"remote": true
		}
	],
	/**
   * R2 bucket for migrated media (blog images, page assets from wp-content/uploads).
   * Access via getCloudflareContext().env.MEDIA.
   * Run `npx wrangler r2 bucket create clauwi-media` before deploying.
   * Local dev uses a simulated bucket under .wrangler/state — no remote bucket needed.
   */
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "clauwi-media"
		}
	]
}