{
	"$schema": "node_modules/wrangler/config-schema.json",
	/**
   * Two environments:
   *   - top level  = STAGING (default): `npm run deploy` → staging.clauwi.pl,
   *     Worker "clauwi-staging", database clauwi-db-staging.
   *   - env.prod   = PRODUCTION: `npm run deploy:prod` → clauwi.pl, Worker
   *     "clauwi" (the name the live Worker has always had, so its secrets and
   *     custom domains stay attached), database clauwi-db.
   *
   * vars, routes, d1_databases and r2_buckets are NOT inherited by env.prod —
   * wrangler requires them to be repeated there. Keep both blocks in sync.
   * Secrets are per Worker: set each one for both, e.g.
   *   npx wrangler secret put BREVO_API_KEY            (staging)
   *   npx wrangler secret put BREVO_API_KEY --env prod (production)
   */
	"name": "clauwi-staging",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-26",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	/**
   * Plain-text environment variables.
   *
   * These MUST live here rather than being typed into the Cloudflare
   * dashboard: for non-secret vars this file is authoritative, so every
   * deploy replaces the Worker's variables with exactly what it declares.
   * Values set only in the dashboard are dropped by the next deploy — that is
   * how BREVO_SENDER_EMAIL / BREVO_SENDER_NAME / CONTACT_FORM_TO /
   * COURSE_ORGANIZER_EMAIL disappeared on 2026-08-20 and broke e-mail on
   * staging. Recovered here from version eefdae6e.
   *
   * Anything genuinely secret (BREVO_API_KEY, AUTH_*, TURNSTILE_SECRET_KEY)
   * stays a `wrangler secret` — secrets are NOT touched by deploys.
   *
   * Values below were read back from the live Worker (version e7582c60,
   * 2026-08-20 20:02 UTC) so config and deployment now agree.
   *
   * Staging sends real e-mail, but its own notifications (contact form,
   * organizer copy of bookings) go to a separate inbox so test traffic never
   * lands in the client's.
   */
	"vars": {
		"BREVO_SENDER_EMAIL": "kontakt@clauwi.pl",
		"BREVO_SENDER_NAME": "ClauWi®",
		"CONTACT_FORM_TO": "staging-kontakt@clauwi.pl",
		"COURSE_ORGANIZER_EMAIL": "staging-kontakt@clauwi.pl"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "staging.clauwi.pl",
			"custom_domain": true
		}
	],
	/**
   * D1 database binding. Access in server code via getCloudflareContext().env.DB.
   * Local dev (`next dev`, `db:migrate:local`) uses this top-level config.
   */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "clauwi-db-staging",
			"database_id": "9704a139-3cd4-403d-bc8a-95f6c5ca7443",
			"migrations_dir": "migrations"
		},
		{
			"binding": "clauwi_db",
			"database_name": "clauwi-db-staging",
			"database_id": "9704a139-3cd4-403d-bc8a-95f6c5ca7443",
			"remote": true
		}
	],
	/**
   * R2 bucket for migrated media (blog images, page assets from wp-content/uploads).
   * Access via getCloudflareContext().env.MEDIA. The app only reads from it,
   * so staging and production share the same bucket.
   * Local dev uses a simulated bucket under .wrangler/state — no remote bucket needed.
   */
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "clauwi-media"
		}
	],
	"env": {
		"prod": {
			"name": "clauwi",
			"vars": {
				"BREVO_SENDER_EMAIL": "kontakt@clauwi.pl",
				"BREVO_SENDER_NAME": "ClauWi®",
				"CONTACT_FORM_TO": "kontakt@clauwi.pl",
				"COURSE_ORGANIZER_EMAIL": "kontakt@clauwi.pl"
			},
			// `wrangler deploy` provisions the DNS record and certificate; it
			// fails if another DNS record already holds the name.
			"routes": [
				{
					"pattern": "clauwi.pl",
					"custom_domain": true
				},
				// Redirected to the apex by a Cloudflare Redirect Rule, which runs
				// before the Worker — it only needs to exist so DNS + TLS work.
				{
					"pattern": "www.clauwi.pl",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "clauwi-db",
					"database_id": "046af734-ae68-4958-9d75-7e479349b44d",
					"migrations_dir": "migrations"
				},
				{
					"binding": "clauwi_db",
					"database_name": "clauwi-db",
					"database_id": "046af734-ae68-4958-9d75-7e479349b44d",
					"remote": true
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "clauwi-media"
				}
			]
		}
	}
}
